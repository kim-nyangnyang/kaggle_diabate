            </column>
            <column caption='BMI구간' datatype='string' name='[Calculation_5095260064007675907]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [bmi] &lt; 18.5 then &apos;저체중&apos;&#13;&#10;ELSEIF  [bmi] &lt;=25 then &apos;정상&apos;&#13;&#10;ELSEIF  [bmi] &lt;=30 then &apos;과체중&apos;&#13;&#10;ELSE &apos;비만&apos;&#13;&#10;END' />
