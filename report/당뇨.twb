      <aliases enabled='yes' />
      <column caption='TG/HDL' datatype='real' name='[Calculation_5095260063997173761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[triglycerides]/[hdl_cholesterol]' />
      </column>
      <column caption='나이대' datatype='string' name='[Calculation_5095260064006971394]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [age] &lt;20 then &apos;10s&apos;&#13;&#10;ELSEIF [age] &lt; 40 then &apos;2030s&apos;&#13;&#10;ELSEIF  [age] &lt;60 then &apos;4050s&apos;&#13;&#10;ELSEIF  [age] &lt;80 then &apos;6070s&apos;&#13;&#10;ELSE &apos;olders&apos;&#13;&#10;END' />
      </column>
      <column caption='BMI구간' datatype='string' name='[Calculation_5095260064007675907]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [bmi] &lt; 18.5 then &apos;저체중&apos;&#13;&#10;ELSEIF  [bmi] &lt;=25 then &apos;정상&apos;&#13;&#10;ELSEIF  [bmi] &lt;=30 then &apos;과체중&apos;&#13;&#10;ELSE &apos;비만&apos;&#13;&#10;END' />
      </column>
      <column caption='혈압' datatype='string' name='[Calculation_5095260064012554245]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [systolic_bp] &gt;= 180 OR [diastolic_bp] &gt;= 110 THEN &quot;심각한 고혈압&quot;&#13;&#10;ELSEIF [systolic_bp] &gt;= 160 OR [diastolic_bp] &gt;= 100 THEN &quot;중기 고혈압&quot;&#13;&#10;ELSEIF [systolic_bp] &gt;= 140 OR [diastolic_bp] &gt;= 90 THEN &quot;초기 고혈압&quot;&#13;&#10;ELSEIF [systolic_bp] &gt;= 120 OR [diastolic_bp] &gt;= 80 THEN &quot;주의 필요&quot;&#13;&#10;ELSE &quot;정상&quot;&#13;&#10;END' />
      </column>
      <column caption='운동량' datatype='string' name='[Calculation_5095260064026054663]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [physical_activity_minutes_per_week] &lt; 100 then &apos;운동부족&apos;&#13;&#10;elseif [physical_activity_minutes_per_week] &lt; 300 then &apos;적절&apos;&#13;&#10;else &apos;충분&apos;&#13;&#10;END' />
      </column>
      <column caption='tg/hdl 구간화' datatype='string' name='[Calculation_5095260064030666761]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_5095260063997173761] &lt; 2 THEN &quot;1. 매우 양호 (&lt;2)&quot;&#13;&#10;ELSEIF [Calculation_5095260063997173761] &lt; 3 THEN &quot;2. 양호 (2–3)&quot;&#13;&#10;ELSEIF [Calculation_5095260063997173761] &lt; 4 THEN &quot;3. 경계 (3–4)&quot;&#13;&#10;ELSEIF [Calculation_5095260063997173761] &lt; 6 THEN &quot;4. 위험 (4–6)&quot;&#13;&#10;ELSE &quot;5. 고위험 (≥6)&quot;&#13;&#10;END' />
      </column>
